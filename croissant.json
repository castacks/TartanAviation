  "@type": "sc:Dataset",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "TartanAviation",
  "description": "Multi-modal dataset of terminal-area airspace operations recorded at KAGC (towered) and KBTP (non-towered) near Pittsburgh, PA, 2020-2023: ~3.1M images in 550 videos with aircraft bounding boxes tied to ADS-B, ~3,374 hours of ATC speech, and 661 days of ADS-B trajectories. This description covers the per-video metadata, weather, and ADS-B archives; the vision (3.5 TB) and speech (1.2 TB) archives are fetched with the download scripts in the repository.",
  "url": "https://github.com/castacks/TartanAviation",
  "sameAs": "https://theairlab.org/tartanaviation/",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "version": "1.1.0",
  "datePublished": "2025-03-20",
  "keywords": [
    "aviation",
    "ADS-B",
    "air traffic control",
    "speech recognition",
    "object detection",
    "trajectory prediction",
    "aircraft"
  ],
