        },
        {
          "@id": "adsb-kagc-processed"
        }
      ],
      "encodingFormat": "text/plain",
      "includes": "processed/*.txt",
      "description": "Processed scenes, one file per scene. Headerless CSV with columns Frame, ID, x, y, z, Headwind, Crosswind: Frame in seconds (1 Hz), ID the ICAO address, x/y/z in km in the runway frame, wind components in m/s."
    }
