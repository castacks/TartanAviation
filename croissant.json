        "@id": "vision-videos/video_name"
      },
      "field": [
        {
          "@type": "cr:Field",
          "@id": "vision-videos/video_name",
          "name": "video_name",
          "description": "Video name, <n>_<YYYY-MM-DD-HH-MM-SS> (recording start).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "vision-weather-stats"
            },
            "extract": {
              "column": "video_name"
